PORT=5000
NODE_ENV=development

# Neon PostgreSQL Database
DATABASE_URL=postgresql://username:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connection_limit=5&pool_timeout=20

# JWT Configuration
JWT_SECRET=your_strong_random_secret_here
JWT_EXPIRE=7d

# Cookie Configuration
COOKIE_EXPIRE=7

# SMM Provider API
SMM_PROVIDER_URL=https://worldpanel24.com/api/v2
SMM_PROVIDER_API_KEY=your_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173
